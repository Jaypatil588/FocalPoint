# Explicit provider selection. No automatic substitution or retry.
MODEL_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REQUEST_INTERVAL_SECONDS=15
# When MODEL_PROVIDER=gemini, set these instead.
GEMINI_API_KEY=
GEMINI_MODEL=

# MongoDB replica set, local development or Atlas.
MONGODB_URI=mongodb://127.0.0.1:27028/?replicaSet=focalpoint
MONGODB_DB_NAME=focalpoint_dev
