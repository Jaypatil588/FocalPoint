{
  "name": "focalpoint",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm run backend:dev\" \"npm run frontend:dev\"",
    "backend:dev": "cd backend && ../.venv/bin/python -m uvicorn main:app --reload --port 8000",
    "db:dev": "node scripts/mongo-dev.mjs",
    "test:backend": ".venv/bin/python -m pytest -q",
    "test:browser": "playwright test",
    "test:live": ".venv/bin/python scripts/live_acceptance.py",
    "eval": ".venv/bin/python backend/evaluate.py --baseline",
    "frontend:dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "preview": "cd frontend && npm run preview"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "concurrently": "^10.0.3",
    "mongodb-memory-server": "^10.2.3"
  }
}
